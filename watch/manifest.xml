<?xml version="1.0"?>
<!-- Connect IQ watch app: records a Vitruvian training on the watch. The id must match
     GarminWatchLink.WATCH_APP_ID in :app. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="9ff78d152cd74db0ab2362fb6f1c5352" type="watch-app" name="@Strings.AppName"
        entry="VitruvianApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.4.0">
        <iq:products>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>dut</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
